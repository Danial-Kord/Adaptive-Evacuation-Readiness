# Google Cloud & Vertex AI configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Cloud Run Deployment configuration
CLOUD_RUN_REGION=us-east1
AGENT_SERVICE_NAME=evac-readiness-agent
DASHBOARD_SERVICE_NAME=evac-dashboard
DEPLOYED_AGENT_APP=evac_agent
# Optional: Vertex AI Agent Engine session store URI so chats survive redeploys
# SESSION_SERVICE_URI=agentengine://projects/<project-number>/locations/us-central1/reasoningEngines/<engine-id>
# Optional: Override if running --dashboard-only without querying gcloud
# DEPLOYED_AGENT_URL=https://evac-readiness-agent-<hash>.us-east1.run.app

# Challenge configuration
STATE=FL
BQ_DATASET=evacuation_readiness
GEMINI_MODEL=gemini-3.6-flash

# Optional: MCP Server URL (e.g., Cloud Run MCP Toolbox or Maps Grounding Lite)
MCP_SERVER_URL=https://mapstools.googleapis.com/mcp
MAPS_API_KEY=

# Frontend configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MOCK=false
